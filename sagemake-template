import hashlib
import os
import platform
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

# ── ANSI helpers ──────────────────────────────────────────────────────────────

RESET = "\033[0m"
BOLD = "\033[1m"
RED = "\033[31m"
GREEN = "\033[32m"
YELLOW = "\033[33m"
CYAN = "\033[36m"


def banner(title: str) -> None:
    width = 60
    line = f"{CYAN}{'═' * width}{RESET}"
    print(f"\n{line}")
    print(f"{CYAN}  {BOLD}{title}{RESET}")
    print(f"{line}\n")


def section(title: str) -> None:
    print(f"  {CYAN}→{RESET} {title}")


def step(msg: str) -> None:
    print(f"    {msg} ... ", end="", flush=True)


def ok() -> None:
    print(f"{GREEN}✓ done{RESET}")


def fail() -> None:
    print(f"{RED}✗ failed{RESET}")
    sys.exit(1)


def step_ok(detail: str) -> None:
    print(f"{GREEN}✓ {detail}{RESET}")


def step_fail(detail: str) -> None:
    print(f"{RED}✗ {detail}{RESET}")
    sys.exit(1)


def step_warn(detail: str) -> None:
    print(f"{YELLOW}! {detail}{RESET}")


def run(cmd: list[str], **kwargs) -> subprocess.CompletedProcess:
    """Run a command and return the result."""
    if "env" in kwargs:
        kwargs["env"] = {**os.environ, **kwargs["env"]}
    else:
        kwargs["env"] = os.environ.copy()

    try:
        return subprocess.run(cmd, check=True, **kwargs)
    except subprocess.CalledProcessError as e:
        step_fail(f"command failed with exit code {e.returncode}: {' '.join(cmd)}")
    except FileNotFoundError:
        step_fail(f"command not found: {cmd[0]}")


# ── Configuration ─────────────────────────────────────────────────────────────

ROOT = Path(__file__).resolve().parent
BUILD_DIR = ROOT / "build"
SRC_DIR = ROOT / "src"
TEST_DIR = ROOT / "tests"
PROJECT_NAME = {{ PROJECT_NAME_JSON }}
BINARY_NAME = {{ BINARY_NAME_JSON }}


# ── Helpers ───────────────────────────────────────────────────────────────────

def get_source_hash(directory: Path, args: list[str] = None) -> str:
    """Calculate a single SHA-256 hash for all files in a directory recursively."""
    if not directory.exists():
        return ""
    hasher = hashlib.sha256()

    # Hash the host OS and architecture to prevent cross-platform cache pollution
    sys_info = f"{platform.system()}-{platform.machine()}".encode("utf-8")
    hasher.update(len(sys_info).to_bytes(8, byteorder='big'))
    hasher.update(sys_info)
    hasher.update(b"\0")

    # Hash command-line arguments to prevent caching across different flag invocations
    if args:
        for arg in args:
            arg_bytes = arg.encode("utf-8")
            hasher.update(len(arg_bytes).to_bytes(8, byteorder='big'))
            hasher.update(arg_bytes)
            hasher.update(b"\0")

    # Hash common build environment variables to track hidden compiler states
    env_vars = ["CC", "CFLAGS", "CXX", "CXXFLAGS", "LDFLAGS", "SAGE_PATH"]
    for var in env_vars:
        val = os.environ.get(var, "")
        if val:
            val_bytes = f"{var}={val}".encode("utf-8")
            hasher.update(len(val_bytes).to_bytes(8, byteorder='big'))
            hasher.update(val_bytes)
            hasher.update(b"\0")

    # Also hash this script itself to track build logic changes
    script_path = Path(__file__).resolve()

    try:
        # Pre-calculate the script path relative to the directory to avoid O(N) resolve() calls
        script_rel = script_path.relative_to(directory.resolve())
        script_in_dir = directory / script_rel
    except ValueError:
        script_in_dir = None

    rglob_files = [p for p in sorted(directory.rglob("*"), key=lambda p: p.as_posix()) if p != script_in_dir and "__pycache__" not in p.parts and p.suffix != ".pyc"]
    if script_path.exists():
        files_to_hash = [script_path] + rglob_files
    else:
        files_to_hash = rglob_files

    for filepath in files_to_hash:
        if filepath.is_file():
            # Add path length and path with null byte delimiter to prevent collision
            if filepath == script_path:
                path_bytes = b"\x00__sagemake_script__"
            else:
                path_bytes = filepath.relative_to(directory).as_posix().encode("utf-8")

            hasher.update(len(path_bytes).to_bytes(8, byteorder='big'))
            hasher.update(path_bytes)
            hasher.update(b"\0")

            try:
                # Add file stat metadata (executable bit and size) to detect changes correctly
                # We only track the executable bit to prevent umask determinism violations
                st = filepath.stat()
                exec_bit = 1 if bool(st.st_mode & 0o111) else 0
                hasher.update(exec_bit.to_bytes(8, byteorder='big'))

                # Add content length to prevent collision and stream in chunks for scalability
                hasher.update(st.st_size.to_bytes(8, byteorder='big'))

                with open(filepath, "rb") as f:
                    while chunk := f.read(8192):
                        hasher.update(chunk)
            except Exception as e:
                step_fail(f"failed to read {filepath} for hashing: {e}")
    return hasher.hexdigest()


# ── Commands ──────────────────────────────────────────────────────────────────

def cmd_build(args: list[str]) -> None:
    banner(f"build — {PROJECT_NAME}")
    check_dependencies()
    section("Compilation")

    # Incremental build check
    current_hash = get_source_hash(SRC_DIR, args)
    hash_file = BUILD_DIR / ".build_hash"
    binary_file = BUILD_DIR / BINARY_NAME

    # Calculate binary hash if it exists
    binary_hash = ""
    if binary_file.exists():
        b_hasher = hashlib.sha256()
        try:
            with open(binary_file, "rb") as f:
                while chunk := f.read(8192):
                    b_hasher.update(chunk)
            binary_hash = b_hasher.hexdigest()
        except Exception as e:
            step_fail(f"failed to read {binary_file} for hashing: {e}")

    combined_hash = f"{current_hash}:{binary_hash}"

    if hash_file.exists() and current_hash != "" and binary_hash != "":
        cached_hash = hash_file.read_text(encoding="utf-8").strip()
        if cached_hash == combined_hash:
            step_ok("up-to-date")
            return

    step("compiling source")
    BUILD_DIR.mkdir(parents=True, exist_ok=True)
    # TODO: Add your build logic here
    # Example: run(["gcc", "-o", str(BUILD_DIR / BINARY_NAME), str(SRC_DIR / "main.c")])
    ok()

    # Calculate new binary hash after successful build
    new_binary_hash = ""
    if binary_file.exists():
        b_hasher = hashlib.sha256()
        try:
            with open(binary_file, "rb") as f:
                while chunk := f.read(8192):
                    b_hasher.update(chunk)
            new_binary_hash = b_hasher.hexdigest()
        except Exception as e:
            step_fail(f"failed to read {binary_file} for hashing: {e}")

    new_combined_hash = f"{current_hash}:{new_binary_hash}"

    # Save the new hash after a successful build (atomic write to prevent corruption and race conditions)
    fd, tmp_path = tempfile.mkstemp(dir=BUILD_DIR, prefix=".build_hash_", suffix=".tmp")
    with open(fd, "w", encoding="utf-8") as f:
        f.write(new_combined_hash)
    Path(tmp_path).replace(hash_file)


def cmd_test(args: list[str]) -> None:
    banner(f"test — {PROJECT_NAME}")
    # TODO: Add your test logic here
    # Example: run(["pytest", str(TEST_DIR)])
    step_ok("all tests passed")


def cmd_install(args: list[str]) -> None:
    banner(f"install — {PROJECT_NAME}")
    # On Windows, /usr/local/bin may not exist or make sense; defaulting to a standard prefix
    install_dir = Path("/usr/local/bin") if os.name != "nt" else Path(os.environ.get("APPDATA", "C:/ProgramData")) / PROJECT_NAME
    target = install_dir / BINARY_NAME
    step(f"installing to {target}")
    if not (BUILD_DIR / BINARY_NAME).exists():
        step_fail(f"{BINARY_NAME} not built — run build first")
    try:
        install_dir.mkdir(parents=True, exist_ok=True)
        shutil.copy2(BUILD_DIR / BINARY_NAME, target)
        if os.name != "nt":
            target.chmod(0o755)
    except PermissionError:
        step_fail("permission denied (try running as Administrator/root)")
    except Exception as e:
        step_fail(f"installation failed: {e}")
    step_ok(f"installed {BINARY_NAME}")


def cmd_clean(args: list[str]) -> None:
    banner(f"clean — {PROJECT_NAME}")
    section("Removing build artifacts")
    step(f"removing {BUILD_DIR}")
    if BUILD_DIR.exists():
        try:
            shutil.rmtree(BUILD_DIR)
        except Exception as e:
            step_fail(f"failed to remove build dir: {e}")
    ok()


def cmd_all(args: list[str]) -> None:
    cmd_build(args)
    cmd_test(args)


# ── Dependency check ──────────────────────────────────────────────────────────

def check_dependencies() -> None:
    """Verify required tools are available on PATH."""
    section("Dependencies")
    required = {{ DEPENDENCIES }}
    missing = []
    for dep in required:
        step(f"checking {dep}")
        if shutil.which(dep) is None:
            missing.append(dep)
            print(f"{RED}✗ not found{RESET}")
        else:
            ok()
    if missing:
        step_fail(f"missing: {', '.join(missing)}")


# ── CLI dispatch ──────────────────────────────────────────────────────────────

def main() -> None:
    commands: dict[str, callable] = {
        "build": cmd_build,
        "test": cmd_test,
        "install": cmd_install,
        "clean": cmd_clean,
        "all": cmd_all,
    }

    if len(sys.argv) < 2 or sys.argv[1] not in commands:
        banner(f"{PROJECT_NAME} — sagemake")
        print(f"  Usage:  ./sagemake {'|'.join(commands.keys())}")
        print()
        sys.exit(1)

    cmd = sys.argv[1]
    args = sys.argv[2:]
    commands[cmd](args)


if __name__ == "__main__":
    main()
